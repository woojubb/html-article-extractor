{
  "name": "@html-article-extractor/cli",
  "version": "1.1.0",
  "description": "Fetch a URL and extract its readable article content",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "html-article-extractor": "dist/bin.js"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
