  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jungyoun/html-article-extractor.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "html-article-extractor": "^1.1.0",
    "jsdom": "^27.4.0"
  }
}
